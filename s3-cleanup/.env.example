# Proje kök dizinindeki .env dosyası otomatik okunur.
# Bu dosyayı .env olarak kopyalayıp doldurun.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kampdefterim
DB_USER=postgres
DB_PASSWORD=your_password

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your_bucket_name
