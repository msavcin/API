# AWS ve diğer gizli anahtarlarınızı buraya yazın
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
GMAIL_USER=
GMAIL_PASS=

# Redis Configuration (Tile Cache için)
REDIS_HOST=localhost
# REDIS_PORT=6379
REDIS_PASSWORD=

# Diğer backend ortam değişkenleri
# ör: DATABASE_URL=postgres://user:pass@host:port/dbname

# Apple In-App Purchase (IAP)
APPLE_SHARED_SECRET=

# Google In-App Purchase (IAP)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Package Names / Bundle IDs
ANDROID_PACKAGE_NAME=com.spondylus.boltexponativewind
IOS_BUNDLE_ID=com.spondylus.kampdefterim

# License RSA Public Key (Google Play Console'dan alınan)
LICENSE_RSA_PUBLIC_KEY=
# Environment
NODE_ENV=development

# AI Değerlendirme Servisi
AI_PROVIDER=groq                          # ollama | vllm | llamacpp | groq
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral:7b
# VLLM_BASE_URL=http://localhost:8000
# VLLM_MODEL=mistral
# LLAMACPP_BASE_URL=http://localhost:8080

# Groq API (https://console.groq.com adresinden al)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# NOTE: `llama-3.1-8b-instant` Groq tarafından 2026-08-16 tarihinde kullanımdan kaldırıldı.
# Eğer `.env` içinde bu modele işaret eden bir satır varsa, `openai/gpt-oss-20b` veya uygun başka bir modele güncelleyin.
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b
GROQ_WEB_SEARCH=false                    # true ise compound-beta modeli ile internet araması yapar
GROQ_REASONING=false                      # true ise düşünme modu aktif (qwen3/gpt-oss modelleri)
GROQ_MAX_TOKENS=2500                     # Groq free tier 6000 TPM — 800 input + 2500 output = 3300/istek
GROQ_RETRY_WAIT_MS=55000                 # 429 alininca beklenecek max sure (ms)

# DeepSeek API (https://platform.deepseek.com adresinden al)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Provider seçimi (hybrid mod)
PREVIEW_PROVIDER=groq                # Hızlı yanıtlar için (preview mode) — Groq qwen3, düşük token bütçe
FINAL_PROVIDER=deepseek              # Detaylı yanıtlar için (final mode) — DeepSeek, bol output token

# Optional time-based provider overrides (UTC hours).
# If both AI_PEAK_START_UTC and AI_PEAK_END_UTC are set, the server will check
# the current UTC hour and, if within the window, will use the *_PROVIDER_PEAK
# values (when present). Outside the window *_PROVIDER_OFFPEAK can override.
# Leave empty to keep existing PREVIEW_PROVIDER/FINAL_PROVIDER behavior.
AI_PEAK_START_UTC=16                 # UTC saat (0-23) — örn. 16
AI_PEAK_END_UTC=20                   # UTC saat (0-23) — örn. 20 (exclusive)
PREVIEW_PROVIDER_PEAK=               # Örn: groq | ollama | vllm | llamacpp | deepseek
PREVIEW_PROVIDER_OFFPEAK=            # Örn: groq | deepseek
FINAL_PROVIDER_PEAK=groq             # Örn: groq (daha ucuzsa)
FINAL_PROVIDER_OFFPEAK=deepseek      # Örn: deepseek (detaylı)

AI_EVAL_CACHE_TTL_SEC=3600               # Saniye cinsinden cache süresi (varsayılan: 1 saat)
WEB_RESEARCH_BUSINESS_ONLY=false          # true → Google Places yalnızca işletme isimlerinde | false → her alanda
AI_CONTROLLER_TIMEOUT_MS=90000           # AI yanıtları için zaman aşımı (ms cinsinden, varsayılan: 90 saniye)

# Rota Servisi (gerçek sürüş süresi)
# ROUTE_PROVIDER=osrm                   # osrm (varsayılan, ücretsiz) | google
GOOGLE_MAPS_API_KEY=   # Sadece ROUTE_PROVIDER=google ise gerekli
GOOGLE_PLACES_API_KEY= # Places API için (webResearchService)

# Redis URL (cache.js için — REDIS_HOST/PORT'a ek olarak)
REDIS_URL=redis://localhost:6379

# AI Review Evaluation (Google Places yorumlarını değerlendirme)
AI_REVIEW_TEMPERATURE=0.7               # AI sıcaklık parametresi (0.0-1.0, düşük=tutarlı, yüksek=yaratıcı)
AI_REVIEW_MAX_TOKENS=2000               # Maksimum yanıt uzunluğu (token cinsinden)